---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title={`404 — Page Not Found | ${site.name}`}>
  <div class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <!-- 404 Visual -->
      <div class="mb-8">
        <span class="font-display text-8xl md:text-9xl font-extrabold text-gradient-cyan">404</span>
      </div>

      <!-- Message -->
      <h1 class="font-display text-2xl md:text-3xl font-bold text-white mb-4">
        Lost in Space
      </h1>
      <p class="text-white/40 max-w-md mx-auto mb-8 leading-relaxed">
        This entity doesn't exist in our ecosystem. The space you're looking for has either moved or was never created.
      </p>

      <!-- CTA -->
      <a
        href="/"
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-quantum-cyan text-deep-space font-display font-semibold text-sm tracking-wider uppercase rounded-lg hover:shadow-[0_0_30px_rgba(0,180,230,0.3)] hover:scale-105 transition-all duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Return to <span class="font-brand">{site.name}</span>
      </a>
    </div>
  </div>
</Layout>
