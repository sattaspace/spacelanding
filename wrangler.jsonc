{
  "name": "spacelanding",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_NAME": "SattaSpace",
    "PUBLIC_SITE_TAGLINE": "The Space of Being",
    "PUBLIC_SITE_URL": "https://sattaspace.com",
    "PUBLIC_SITE_DESCRIPTION": "Where entities find their space. SattaSpace is the mother hub — the foundational ecosystem from which innovation, creativity, and ventures emerge.",
    "PUBLIC_SITE_KEYWORDS": "sattaspace,ecosystem,hub,innovation,ventures,bangladesh,সত্ত্বা",
    "PUBLIC_SITE_LOCALE": "en",
    "PUBLIC_THEME_COLOR": "#0A1F44",
    "PUBLIC_CONTACT_EMAIL": "hello@sattaspace.com",
    "PUBLIC_CONTACT_LOCATION": "Dhaka, Bangladesh",
    "PUBLIC_FOUNDING_YEAR": "2024",
    "PUBLIC_GA_MEASUREMENT_ID": "",
    "PUBLIC_GTM_ID": "",
    "NODE_ENV": "production"
  }
}